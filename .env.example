# Copy this file to .env and fill in real values for local development.
# Never commit real secrets.

# Required: PostgreSQL connection settings used by Drizzle ORM and pg.
SQL_HOST="your-postgres-host"
SQL_USER="your-postgres-user"
SQL_PASSWORD="your-postgres-password"
SQL_DB_NAME="your-postgres-database"

# Required: secret used to sign HS256 JWT access tokens.
# Must be at least 32 characters long. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional: public app URL, used for exact-origin CORS matching.
APP_URL="https://your-frontend-origin.example"

# Optional: additional allowed CORS origins, comma-separated.
CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# Optional: set to "disable" only for a local PostgreSQL server without SSL.
# Default: SSL is enabled for non-local hosts and disabled for localhost/127.0.0.1.
PGSSLMODE="prefer"

# Optional: HTTP port for the Express server (default: 3000).
PORT="3000"

# Optional: set to "production" to serve dist/ from Express instead of Vite dev middleware.
NODE_ENV="production"

# Optional: injected by AI Studio; no code path in this repo reads it directly.
GEMINI_API_KEY="your-gemini-api-key"

# Firebase Web configuration lives in firebase-applet-config.json, not in environment variables.
# The backend Firebase Admin SDK uses the projectId from that same file to verify Google ID tokens.
